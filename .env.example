# --- Скат API (backend) ---
# Frontend origins allowed by CORS, comma separated. Include your Vercel production domain.
ALLOWED_ORIGINS=https://scat-search.vercel.app,http://localhost:5173
# Optional: allow Vercel preview deployments of this project.
# ALLOWED_ORIGIN_REGEX=https://your-project-[a-z0-9-]+-your-team\.vercel\.app
# Enables /api/admin/* (force rescan, clear cache). Leave empty to disable them.
ADMIN_TOKEN=
# 24 hours by default.
CACHE_TTL_SECONDS=86400
# Only behind your own reverse proxy (nginx/Caddy), so rate limiting sees real client IPs.
TRUST_PROXY_HEADERS=false
