# Скат production settings. Copy to .env (deploy.sh creates it for you) and never commit .env.
#
#   [generated]  deploy.sh fills this in with `openssl rand -hex 32` when it creates .env
#   [build]      compiled into the frontend by `docker compose build`; rebuild after changing
#   [runtime]    read by the backend container at start; `docker compose up -d` after changing
#
# Paths inside the backend image (XRAY_BINARY, DATA_DIR, CONFIG_FILE) are set by the
# Dockerfile and are not configured here.

# --- Docker Compose ---------------------------------------------------------------
# Lets a plain `docker compose ...` in /opt/scat manage both backend and frontend.
COMPOSE_PROJECT_NAME=scat
COMPOSE_FILE=docker-compose.yml:docker-compose.frontend.yml

# --- Backend [runtime] --------------------------------------------------------------
# REQUIRED. Exact browser origins allowed by CORS, comma separated, no trailing slash.
# Never "*". Local dev: http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ORIGINS=https://scat-search.ru,https://www.scat-search.ru
# Optional regex for extra origins (e.g. preview deployments). Leave unset in production.
# ALLOWED_ORIGIN_REGEX=

# SECRET [generated]. Signs in to the admin panel (/admin/) and authenticates scripts
# (Authorization: Bearer ...) on /api/admin/*. Empty = admin panel and API disabled (404).
# Changing it ends every admin session.
ADMIN_TOKEN=
# ADMIN_SESSION_TTL_SECONDS=43200    # admin panel session lifetime
# ADMIN_SESSION_IDLE_SECONDS=7200    # ... and idle timeout

# true only behind your own reverse proxy (Caddy here), so rate limits see real client IPs.
# The API port is bound to 127.0.0.1, so clients cannot bypass Caddy to forge the header.
TRUST_PROXY_HEADERS=true

# How often anyone may force a fresh scan with the "Очистить кэш" button, seconds.
REFRESH_COOLDOWN_SECONDS=600
# Scan cache lifetime, seconds (24 hours).
CACHE_TTL_SECONDS=86400

# Optional backend tuning; unset = the defaults in app/config.py.
# SCAN_RATE_LIMIT_PER_MINUTE=6    # scan-starting requests per client IP per minute
# MAX_QUEUED_SCANS=3              # country searches allowed to wait in line
# AUTO_SCAN_ON_STARTUP=true       # scan at start when the cache is missing/expired
# AUTO_REFRESH=true               # rescan whenever the main cache expires
# DEBUG=false                     # verbose scanner logging
# Scanner: MAX_NODES=30000 SOURCE_CONCURRENCY=20 SOURCE_TIMEOUT=45 BATCH_SIZE=500 WORKERS=300
#          TIMEOUT=4.0 CANDIDATE_COUNT=25 TOP_COUNT=5 DEEP_ATTEMPTS=5 DEEP_MIN_SUCCESS=4 PORT_START=20000

# --- Provider probes [runtime] (docs/PROBES.md) ------------------------------------------
# Public https origin of the API, used in probe install commands and download URLs.
# deploy.sh sets it; behind Caddy the API cannot see its own public address.
PUBLIC_API_URL=https://api.scat-search.ru
# New probes verify themselves automatically (they must fetch a one-time URL on this API,
# which needs PUBLIC_API_URL). true skips verification: only for closed deployments.
# PROBE_AUTO_APPROVE=false
# PROBE_VERIFY_TIMEOUT_SECONDS=600   # time to pass verification
# PROBE_VERIFY_RETRY_SECONDS=1800    # wait before an automatic retry
# PROBE_VERIFY_MAX_ATTEMPTS=3        # automatic attempts (an admin can always re-run)
# PROBE_SPOT_CHECK_SECONDS=21600     # hidden one-time-URL checks of approved probes; 0 = off
# RANKING_USE_PROBE_SCORE=true       # probe-confirmed configs rank first
# Probes' real ASN is looked up from the IP they registered from (sends that IP to RIPE NCC).
# Empty disables detection. Default:
# ASN_LOOKUP_URL=https://stat.ripe.net/data/prefix-overview/data.json?resource={ip}
# PROBE_RESULT_TTL_SECONDS=86400   # how long a reachability result is reused
# PROBE_OFFLINE_AFTER_SECONDS=100  # ~3 missed heartbeats (heartbeat every 30 s)
# PROBE_TARGET_COUNT=25            # best configs of each full scan that probes check
# PROBE_CONTROL_URL=https://www.gstatic.com/generate_204

# --- Frontend [build] ----------------------------------------------------------------
# REQUIRED. Public API origin the browser calls, https, no trailing slash.
VITE_API_URL=https://api.scat-search.ru
# Recommended. Public site origin: canonical, Open Graph and structured-data URLs, sitemap.xml.
VITE_SITE_URL=https://scat-search.ru
# Optional donation page; the support button is hidden while empty.
VITE_DONATE_URL=
# Optional ownership proofs for Google Search Console and Yandex Webmaster: only the
# content="..." value of the <meta> tag each service offers. Rebuild the frontend after setting.
VITE_GOOGLE_SITE_VERIFICATION=
VITE_YANDEX_VERIFICATION=
