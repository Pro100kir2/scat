# Backend origin without trailing slash. Leave empty in local dev: Vite proxies /api to :8000.
VITE_API_URL=
# Public URL of this site (canonical, Open Graph, structured data, sitemap.xml), e.g. https://skat.example.com
VITE_SITE_URL=
# Donation page (Boosty, CloudTips, Ko-fi...). The support button stays hidden while empty.
VITE_DONATE_URL=https://finance.ozon.ru/apps/sbp/ozonbankpay/019c0089-d12a-7ee5-a9ea-e192cfcc45b1
# Search Console / Yandex Webmaster verification: the content="..." value of their <meta> tag.
VITE_GOOGLE_SITE_VERIFICATION=
VITE_YANDEX_VERIFICATION=
