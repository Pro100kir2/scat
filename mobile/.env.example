# Copy to .env.local for local development (never committed). Only public, client-safe
# values belong here: everything prefixed EXPO_PUBLIC_ is compiled into the app bundle.

# The Скат API. For a backend on your own machine use your computer's LAN address
# (a phone cannot reach "localhost"), e.g. http://192.168.1.20:8000
EXPO_PUBLIC_API_URL=https://api.scat-search.ru

# The public site: links to "add a provider", the install guide.
EXPO_PUBLIC_SITE_URL=https://scat-search.ru
