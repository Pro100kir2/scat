{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_URL": "https://api.scat-search.ru", "EXPO_PUBLIC_SITE_URL": "https://scat-search.ru" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_API_URL": "https://api.scat-search.ru", "EXPO_PUBLIC_SITE_URL": "https://scat-search.ru" }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": { "EXPO_PUBLIC_API_URL": "https://api.scat-search.ru", "EXPO_PUBLIC_SITE_URL": "https://scat-search.ru" }
    }
  },
  "submit": {
    "production": {}
  }
}
